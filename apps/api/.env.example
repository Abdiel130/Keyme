# En Docker estas variables llegan desde el .env de la raíz (docker-compose.yml).
APP_NAME=Keyme
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_LOCALE=es

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=keyme
DB_USERNAME=keyme
DB_PASSWORD=

CACHE_STORE=database
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

KEYME_SETUP_TOKEN=
KEYME_DATA_PATH=/data
