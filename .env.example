# Configuración de Keyme. ./up.sh --setup la llena con un formulario.
# Nunca subas el .env real: contiene secretos.

# Puerto local de la PWA (solo escucha en 127.0.0.1; Tailscale Serve lo publica en el tailnet)
KEYME_PORT=8470

# PostgreSQL
DB_DATABASE=keyme
DB_USERNAME=keyme
DB_PASSWORD=

# Laravel
APP_KEY=
APP_URL=http://localhost:8470

# Token de un solo uso para crear el vault desde la PWA
KEYME_SETUP_TOKEN=

# Respaldos automáticos (pg_dump + adjuntos cifrados)
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_HOUR=03

# Tamaño máximo de un adjunto, en MB
KEYME_ATTACHMENT_MAX_MB=25
